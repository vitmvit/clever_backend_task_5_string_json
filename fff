    /**
     * Преобразует строку JSON в объект указанного класса.
     *
     * @param json  строка в формате JSON, представляющая объект
     * @param clazz класс, к которому нужно преобразовать JSON
     * @param <T>   тип объекта
     * @return объект, созданный на основе строки JSON
     * @throws JsonConverterException если строка JSON некорректна
     */
    @Override
    public <T> T convert(String json, Class<T> clazz) {
        if (isJson(json)) {
            var t = convert(buildMap(json), clazz);
            return t;
        } else {
            throw new JsonConverterException("Incorrect JSON string");
        }
    }

    /**
     * Проверяет, является ли строка корректной JSON-строкой.
     *
     * @param json строка для проверки
     * @return true, если строка является корректной JSON-строкой, иначе false
     */
    private boolean isJson(String json) {
        if (json == null || json.isEmpty()) {
            return false;
        }
        if (!json.contains("{")) {
            return false;
        }
        if (json.trim().startsWith("{") && json.trim().endsWith("}")) {
            return checkJson(json, '{', '}') && checkJson(json, '[', ']');
        }
        return false;
    }

    /**
     * Проверяет, сбалансированы ли символы (открывающие и закрывающие) в строке JSON.
     *
     * @param json    строка JSON для проверки
     * @param symbol1 символ открытия (например, '{' или '[')
     * @param symbol2 символ закрытия (например, '}' или ']')
     * @return true, если количество открывающих и закрывающих символов совпадает, иначе false
     */
    private boolean checkJson(String json, char symbol1, char symbol2) {
        int open = 0;
        int close = 0;
        for (int i = 0; i < json.length(); i++) {
            if (json.charAt(i) == symbol1) {
                ++open;
            }
            if (json.charAt(i) == symbol2) {
                ++close;
            }
        }
        return open == close;
    }

